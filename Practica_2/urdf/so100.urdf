<robot name="so100">
<!--Información de eslabones-->
<link name="base_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="../meshes/Base.STL" scale="1 1 1"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="shoulder_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0"/>
        <geometry>
            <mesh filename="../meshes/Shoulder_Rotation_Pitch.STL" scale="1.666 1 1"/>
        </geometry>
        <material name="rojo">
            <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="upper_arm_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 -1.57 0.0"/>
        <geometry>
            <mesh filename="../meshes/Upper_Arm.STL" scale="1 1 1"/>
        </geometry>
        <material name="verde">
            <color rgba="0.0 1.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="lower_arm_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.57 1.57 0.0"/>
        <geometry>
            <mesh filename="../meshes/Lower_Arm.STL" scale="1 1 1"/>
        </geometry>
        <material name="magenta">
            <color rgba="1.0 0.0 1.0 1.0"/>
        </material>
    </visual>
</link>

<link name="wrist_pitch_roll_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 -1.57 0.0"/>
        <geometry>
            <mesh filename="../meshes/Wrist_Pitch_Roll.STL" scale="1 1 1"/>
        </geometry>
        <material name="azul">
            <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
    </visual>
</link>

<link name="fixed_gripper_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="-1.57 0.0 1.57"/>
        <geometry>
            <mesh filename="../meshes/Fixed_Gripper.STL" scale="1 1 1"/>
        </geometry>
        <material name="amarillo">
            <color rgba="1.0 1.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<link name="moving_jaw_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 3.14 0.0"/>
        <geometry>
            <mesh filename="../meshes/Moving_Jaw.STL" scale="1 1 1"/>
        </geometry>
        <material name="blanco">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
    </visual>
</link>

<!--Información de articulaciones-->
<joint name="joint_1" type="revolute">
    <origin xyz="0.0 -0.045 0.016" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>

<joint name="joint_2" type="revolute">
    <origin xyz="0.0187 -0.0306 0.1025" rpy="0.0 1.57 0.0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-0.209" upper="3.14" effort="10.0" velocity="10.0"/>
</joint>

<joint name="joint_3" type="revolute">
    <origin xyz="-0.02725 0.11245 0.0" rpy="0.0 3.14 0.0"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="0.0872" upper="3.14" effort="10.0" velocity="10.0"/>
</joint>

<joint name="joint_4" type="revolute">
    <origin xyz="0.00552 -0.1349 0.0" rpy="0.0 0.0 0.0"/> 
    <parent link="lower_arm_link"/>
    <child link="wrist_pitch_roll_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-1.308" upper="3.14" effort="10.0" velocity="10.0"/>
</joint>

<joint name="joint_5" type="revolute">
    <origin xyz="-0.00044 -0.06193 0.0" rpy="1.57 1.57 0.0"/>
    <parent link="wrist_pitch_roll_link"/>
    <child link="fixed_gripper_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="10.0"/>
</joint>

<joint name="joint_6" type="revolute">
    <origin xyz="0.0 -0.02026 0.02434" rpy="-1.57 0.0 1.57"/>
    <parent link="fixed_gripper_link"/>
    <child link="moving_jaw_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-0.174" upper="0.174" effort="10.0" velocity="10.0"/>
</joint>

</robot>