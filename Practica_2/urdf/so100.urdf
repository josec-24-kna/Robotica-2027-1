<robot name="so100">
<!--Información de eslabones-->
<link name="base_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="Base.STL" scale="1 1 1"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>
<link name="shoulder_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="Shoulder_Rotation_Pitch.STL" scale="1 1 1"/>
        </geometry>
        <material name="rojo">
            <color rgba="1 0.0 0.0 1.0"/>
        </material>
    </visual>
    <visual>
        <origin xyz="0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <sphere radius="0.01"/>
        </geometry>
        <material name="negro">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<!--Información de articulaciones-->
<joint name="shoulder_joint" type="revolute">
    <origin xyz="0.0 -0.045 0.016" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0.0 0.0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
</joint>
</robot>